#!/usr/bin/env python3
"""jev-mcp — terminal-delight plugin #4: typed judgement, and only if you have it.

A tiny MCP server (newline-delimited JSON-RPC 2.0 over stdio, the same transport
as TD's host in `app/src/plugins.rs`) putting TypeSafe's System One — Jev — behind
the plugin boundary.

WHY THIS IS A PLUGIN AND NOT A FEATURE
--------------------------------------
terminal-delight is a public repository. Jev is a hosted model behind an API key
that most people cloning this do not have, will not get today, and should never
need. So TD carries no HTTP client, no key, no model id and no question text: its
*only* route to Jev is this file, and this file is only ever reached if somebody
installed it on purpose. A checkout with no `jev-mcp` on it has no Jev surface at
all — not a greyed one waiting for a key, and above all not a zero.

THREE ABSENCES, THREE ANSWERS
-----------------------------
They are not the same fact and are never collapsed:

  1. This server is not installed        → TD's `discover()` never returns it and
                                           no Jev surface is drawn anywhere.
  2. Installed, but no client or no key  → every tool answers `available: false`
                                           with a `reason`. TD draws *unknown*.
  3. Configured, but the call abstained  → that answer is `null` with a `reason`
     (timeout, transport, below the         (per question — the others still
     confidence floor, no answer given)     stand). TD draws *unknown*, and the
                                           abstentions are counted separately
                                           from every real answer.

A number that means "I did not get an answer" is the bug this file is written to
avoid, so no field here defaults to zero, to false, or to an empty map.

IT WRITES NO CLIENT
-------------------
The Jev wire format, its ports and its abstention semantics already exist in the
`jev` package (`JevClient.ask_many`). This server imports it and adapts MCP onto
it, and reports `available: false` when it cannot be imported. Duplicating that
client here would give us a second one to keep correct, and the second copy is
always the stale one.

  pip install jev            — or —
  TD_JEV_HOME=/path/to/jev-integrations   (a checkout; prepended to sys.path)

BACKEND AND KEY
---------------
Resolved from the environment, never from an argument and never from this file.
A key names its vendor, so with no base URL named the plugin follows the key
rather than a constant that may contradict it:

  SYSTEMONE_BASE_URL   where to send it. Unset, the key below decides, because a
                       key that names a vendor can only authenticate against that
                       vendor. Set, it wins outright — a local System One server
                       is a real target no key implies. The two hosts serve an
                       identical wire format.
  TYPESAFE_API_KEY | OPENROUTER_API_KEY | SYSTEMONE_API_KEY
                       the first one set names the header this run uses. The
                       value is read by the client, never by this file, and is
                       never echoed into a tool result. The first two name a
                       vendor and therefore a host; the third names neither and
                       pairs with whatever base URL is given.
  TD_JEV_MODEL         default jev-latest
  TD_JEV_TIMEOUT_S     default 10
  TD_JEV_MIN_CONFIDENCE
                       default 0.0 — NO floor. A threshold is a measurement, and
                       nobody has run labelled cases for these questions yet, so
                       shipping one would be a number nothing measured. Every
                       answer comes back with its own probability; set this only
                       once you have swept it on cases of your own.

TOOLS
-----
  jev_status         is there a client, a backend, and a key that belongs to that
                     backend? Makes no paid call — so `available: true` means
                     nothing checkable says this will fail, never that
                     authentication succeeded. Only a call can prove that.
  judge              any typed question set over any state — the general verb.
  workspace_weather  what each agent pane is doing.
  rail_weather       the project rail's ticker frames, ranked by what reading
                     each one first would make the reader do.

Every question's wording lives here, so terminal-delight's own source contains no
Jev vocabulary at all.
"""
import json
import os
import sys

PROTOCOL = "2024-11-05"
NAME = "jev"
VERSION = "0.1.0"

DEFAULT_BASE_URL = "https://api.typesafe.ai"

# A key names its vendor, so it also names the only host it can authenticate
# against. Keeping these paired is what stops the plugin reporting itself ready
# while holding an OpenRouter key pointed at TypeSafe's own endpoint — a pairing
# that 401s on every question, which is exactly the confident-wrong-value this
# plugin exists to refuse. Order is preference when several are set.
KEY_HOSTS = (
    ("TYPESAFE_API_KEY", "https://api.typesafe.ai"),
    ("OPENROUTER_API_KEY", "https://openrouter.ai/api"),
    # Generic by design: it names no vendor, so it implies no host and pairs
    # with whatever SYSTEMONE_BASE_URL says, including a local server.
    ("SYSTEMONE_API_KEY", None),
)
KEY_ENVS = tuple(name for name, _ in KEY_HOSTS)
KNOWN_HOSTS = {host for _, host in KEY_HOSTS if host}


# ---------------------------------------------------------------------------
# resolving the client — the one place absence is decided
# ---------------------------------------------------------------------------

def _import_jev():
    """Return (JevClient, HostedPort) or (None, reason).

    `TD_JEV_HOME` points at a `jev-integrations` checkout for people running from
    source; an installed package needs nothing. Both paths fail the same way — by
    saying so — rather than by raising into the host.
    """
    home = os.environ.get("TD_JEV_HOME", "").strip()
    if home and os.path.isdir(home) and home not in sys.path:
        sys.path.insert(0, home)
    try:
        from jev import JevClient  # noqa: F401
        from jev.ports.hosted import HostedPort  # noqa: F401
    except Exception as e:
        hint = "set TD_JEV_HOME to a jev-integrations checkout, or pip install jev"
        return None, "no jev client: %s (%s)" % (e, hint)
    if home:
        # A checkout keeps its key in its own gitignored `.env`, which is the one
        # place it already lives. Loading it here means terminal-delight's config
        # never holds a key and this repository never has a reason to. `load`
        # leaves anything already exported alone and returns names, not values.
        try:
            from jev.dotenv import load
            load()
        except Exception:
            pass  # no .env, or an older checkout without the loader
    return (JevClient, HostedPort), None


def _key_env():
    """Which env var holds the key this run — or None if none is set.

    None is not "" and is not "no key needed": a local System One server on
    127.0.0.1 legitimately wants no key, which is why an absent key is reported
    rather than treated as a failure.
    """
    for name in KEY_ENVS:
        if os.environ.get(name, "").strip():
            return name
    return None


def _key_host(key_env):
    """The one host a given key can authenticate against, or None if it names no vendor."""
    for name, host in KEY_HOSTS:
        if name == key_env:
            return host
    return None


def _base_url(key_env=None):
    """Where to send the request.

    An explicit `SYSTEMONE_BASE_URL` always wins — a person who named a host meant
    it, and a local System One server is a legitimate target no key implies. With
    nothing named, follow the key: defaulting to a constant that contradicts the
    only credential on the machine produces a plugin that reports itself ready and
    401s on every question.
    """
    explicit = os.environ.get("SYSTEMONE_BASE_URL", "").strip()
    if explicit:
        return explicit
    return _key_host(key_env) or DEFAULT_BASE_URL


def _is_local(url):
    return "127.0.0.1" in url or "localhost" in url or "://0.0.0.0" in url


def _status():
    """The whole availability picture, with no call made.

    `available: true` means **nothing checkable says this will fail** — the client
    imports, a key is present where one is needed, and the key and the host can
    belong to each other. It is not a claim that authentication succeeded, because
    proving that costs a request and this verb deliberately makes none. The only
    proof is a call, and every call reports its own failure per question.

    What it must never do is say `true` with a `null` reason while holding a
    pairing that cannot work. That happened: an OpenRouter key against TypeSafe's
    own endpoint, reported ready, 401 on all seven frames. A confident wrong value
    in the field that reports whether the boundary is up is the worst place in
    this plugin for one, so the checkable half is now actually checked.
    """
    mods, reason = _import_jev()
    key = _key_env()
    base = _base_url(key)
    model = os.environ.get("TD_JEV_MODEL", "").strip() or "jev-latest"
    if mods is None:
        return {
            "available": False,
            "reason": reason,
            "client": False,
            "base_url": base,
            "key_env": key,
            "model": model,
        }
    if key is None and not _is_local(base):
        return {
            "available": False,
            "reason": "no API key: set one of %s (a local System One server on "
                      "127.0.0.1 needs none)" % ", ".join(KEY_ENVS),
            "client": True,
            "base_url": base,
            "key_env": None,
            "model": model,
        }
    # Only a KNOWN host paired with a KNOWN-and-different key is a certain
    # failure. A self-hosted endpoint, a proxy, or anything on 127.0.0.1 cannot
    # be judged from here and is left alone — a check that cries wolf gets
    # switched off, and then nothing is checked at all.
    want = _key_host(key)
    if want and base in KNOWN_HOSTS and base != want:
        return {
            "available": False,
            "reason": "%s cannot authenticate against %s — it belongs to %s. Unset "
                      "SYSTEMONE_BASE_URL to follow the key, or set the key for this "
                      "host." % (key, base, want),
            "client": True,
            "base_url": base,
            "key_env": key,
            "model": model,
        }
    return {
        "available": True,
        "reason": None,
        "client": True,
        "base_url": base,
        "key_env": key,
        "model": model,
    }


def _client():
    """A configured JevClient, or (None, status) when one cannot be built."""
    st = _status()
    if not st["available"]:
        return None, st
    (JevClient, HostedPort), _ = _import_jev()
    try:
        floor = float(os.environ.get("TD_JEV_MIN_CONFIDENCE", "0") or 0)
    except ValueError:
        floor = 0.0
    try:
        timeout = float(os.environ.get("TD_JEV_TIMEOUT_S", "10") or 10)
    except ValueError:
        timeout = 10.0
    c = JevClient(
        st["base_url"],
        port=HostedPort(st["model"]),
        api_key_env=st["key_env"] or "SYSTEMONE_API_KEY",
        min_confidence=floor,
        timeout_s=timeout,
    )
    return c, st


def _answer(d):
    """One `Decision` → JSON, keeping every absence as null.

    `value` is null when the backend abstained or gave nothing. `probabilities`
    is null — never `{}` — when none came back, because an empty distribution and
    an unreported one are different facts and only one of them is evidence.
    """
    return {
        "kind": getattr(d, "kind", None),
        "value": None if getattr(d, "abstained", False) else getattr(d, "value", None),
        "probabilities": getattr(d, "probabilities", None) or None,
        "confidence": getattr(d, "confidence", None),
        "abstained": bool(getattr(d, "abstained", False)),
        "reason": getattr(d, "reason", None),
        "latency_ms": getattr(d, "latency_ms", None),
        "backend": getattr(d, "backend", None),
    }


# ---------------------------------------------------------------------------
# judge — the general verb
# ---------------------------------------------------------------------------

def do_judge(args):
    state = args.get("state")
    questions = args.get("questions") or {}
    if not isinstance(questions, dict) or not questions:
        return {"available": False,
                "reason": "judge needs a non-empty `questions` map "
                          "(id → question); independent questions over one state "
                          "are evaluated in parallel in a single request",
                "answers": None}
    c, st = _client()
    if c is None:
        return {"available": False, "reason": st["reason"], "answers": None}
    answers = c.ask_many(state, questions)
    return {
        "available": True,
        "reason": None,
        "backend": st["model"],
        "answers": {k: _answer(v) for k, v in answers.items()},
    }


# ---------------------------------------------------------------------------
# workspace_weather — the questions live here, not in terminal-delight
# ---------------------------------------------------------------------------

# One Choice per pane. Five outcomes, the fifth of which is the escape hatch: a
# Choice cannot answer with an option it was not given, so without `unclear` a
# pane whose fields say nothing gets forced onto the nearest option and comes
# back looking like a real answer with a real probability.
PANE_STATES = ("working", "needs_person", "stalled", "done", "unclear")

# What a row may say, which is more than the model may answer. `not_an_agent` is
# read off the pane's mode and never asked — a shell prompt is not an agent that
# has stalled, and the first run of these questions scored one at 0.49 between
# `stalled` and everything else, which is a coin toss dressed as a verdict.
ROW_STATES = PANE_STATES + ("not_an_agent",)

AGENT_MODES = ("claude", "codex", "agent")

PANE_CRITERIA = {
    "working": {
        "description": "The agent is carrying the task forward right now — running a "
                       "command, editing a file, reading code, or searching. A tool "
                       "call in flight or a small `idle_s` is this even when the line "
                       "reports a step that finished: one finished step is not a "
                       "finished task.",
        "not": "Not this when the agent has stopped and is waiting for anyone.",
    },
    "needs_person": {
        "description": "The agent has stopped and cannot continue until the person "
                       "answers it: it asked a question, offered a choice, or wants "
                       "permission for something.",
        "example": "The last line is a question addressed to the reader.",
    },
    "stalled": {
        "description": "The agent is neither working nor asking. It repeated the same "
                       "step without getting anywhere, hit an error it did not recover "
                       "from, or went quiet with the task unfinished.",
        "not": "Not this when the agent is simply waiting for a long command.",
    },
    "done": {
        "description": "The agent reported the whole task complete and is waiting for a "
                       "new one — a closing summary, a handover, or a plain statement "
                       "that it has finished.",
        "not": "Not this when it finished one step and the task carries on.",
    },
    "unclear": {
        "description": "The fields given do not say enough to tell the others apart. "
                       "Choose this rather than guessing between them.",
    },
}

# Fields a pane may carry. Anything outside this set is dropped before the state
# is sent: accuracy falls as a state grows with material no question names, and a
# pane's cwd and pid are not evidence about what it is doing.
PANE_FIELDS = ("id", "title", "mode", "last_tool", "last_line", "idle_s")


def _pane_question(idx):
    p = "`panes[%d]" % idx
    return {
        "type": "choice",
        "instructions":
            "%s` is one AI coding agent working in a terminal pane. From %s.title`, "
            "%s.last_tool`, %s.last_line` and %s.idle_s` — the agent's own most recent "
            "activity — decide what that agent is doing at this moment. Judge only this "
            "pane; the other panes in `panes` are other people's work and are not "
            "evidence about this one." % (p, p, p, p, p),
        "options": list(PANE_STATES),
        "criteria": {k: PANE_CRITERIA[k] for k in PANE_STATES},
    }


def _trim(pane):
    return {k: pane.get(k) for k in PANE_FIELDS if k in pane}


def do_workspace_weather(args):
    """What every agent pane is doing — measured where it can be, judged where it can't.

    Three things are deliberately NOT asked of the model:

      * A pane running a plain shell is not an agent, which its `mode` says
        outright. Asking anyway buys a flat answer between options none of which
        fit. A pane with no `mode` at all is a different fact and IS asked.
      * A pane whose `awaiting_input` is true is already known to want the person.
        That is a fact TD read off the pane, not a judgement, so the pane is never
        sent — and `awaiting_input: null` (TD could not tell) IS sent, because
        unknown is not false.
      * The headline counts. Jev does not count, and a total assembled from its
        answers in code is one we can check. Abstentions are totalled on their own
        line and never folded into any of the others.
    """
    panes = args.get("panes")
    if not isinstance(panes, list):
        return {"available": False, "reason": "workspace_weather needs a `panes` array",
                "panes": None}

    out = []
    ask_idx = []          # index in `judged` → index in `out`
    judged = []           # the panes actually sent
    for pane in panes:
        pid = pane.get("id")
        mode = pane.get("mode")
        if isinstance(mode, str) and mode.strip() and mode.strip().lower() not in AGENT_MODES:
            out.append({"id": pid, "state": "not_an_agent", "p": None,
                        "source": "measured", "reason": None})
            continue
        if pane.get("awaiting_input") is True:
            out.append({"id": pid, "state": "needs_person", "p": None,
                        "source": "measured", "reason": None})
            continue
        ask_idx.append(len(out))
        out.append({"id": pid, "state": None, "p": None,
                    "source": "judged", "reason": None})
        judged.append(_trim(pane))

    backend = None
    latency_ms = None
    if judged:
        c, st = _client()
        if c is None:
            for i in ask_idx:
                out[i]["reason"] = st["reason"]
            return {"available": False, "reason": st["reason"],
                    "panes": out, "counts": _counts(out),
                    "needs_you": _needs_you(out)}
        backend = st["model"]
        questions = {"pane_%d" % n: _pane_question(n) for n in range(len(judged))}
        answers = c.ask_many({"panes": judged}, questions)
        for n, i in enumerate(ask_idx):
            d = answers.get("pane_%d" % n)
            if d is None or getattr(d, "abstained", False):
                out[i]["reason"] = getattr(d, "reason", None) or "error:missing_answer"
                continue
            value = getattr(d, "value", None)
            if value not in PANE_STATES:
                # An option we did not offer is not an answer. Say so rather than
                # coercing it onto the nearest one.
                out[i]["reason"] = "error:unknown_option"
                continue
            out[i]["state"] = value
            probs = getattr(d, "probabilities", None) or None
            out[i]["p"] = probs.get(value) if probs else None
            if latency_ms is None:
                latency_ms = getattr(d, "latency_ms", None)

    return {
        "available": True,
        "reason": None,
        "backend": backend,
        "latency_ms": latency_ms,
        "panes": out,
        "counts": _counts(out),
        "needs_you": _needs_you(out),
    }


def _counts(rows):
    """One count per state, plus `unknown` on its own line.

    `unknown` is every pane with no answer — abstained, timed out, or never asked
    because the backend was unreachable. It is reported beside the real counts and
    added to none of them, so a caller can always see how much of the picture is
    missing before it believes the rest.
    """
    c = {k: 0 for k in ROW_STATES}
    c["unknown"] = 0
    for r in rows:
        if r["state"] is None:
            c["unknown"] += 1
        else:
            c[r["state"]] += 1
    return c


def _needs_you(rows):
    """How many agents want the person, split by how we know.

    `unknown` rides along: three agents needing you out of twenty reads very
    differently when six of the twenty were never answered for.
    """
    measured = sum(1 for r in rows
                   if r["state"] == "needs_person" and r["source"] == "measured")
    judged = sum(1 for r in rows
                 if r["state"] == "needs_person" and r["source"] == "judged")
    unknown = sum(1 for r in rows if r["state"] is None)
    return {"total": measured + judged, "measured": measured,
            "judged": judged, "unknown": unknown}


# ---------------------------------------------------------------------------
# rail_weather — ranking the project rail's ticker frames
# ---------------------------------------------------------------------------

# One Score, asked once per frame, over the whole reading. It is a Score and not
# a Choice for a reason found in the rail's own code rather than guessed:
# `ProjectState::frames()` is an accumulator. Past the calm early return nothing
# returns and nothing clears, so sections 1 through 7 all push into one vector —
# and section 7 is commented "the derived sentence, last, so it lands after the
# facts it sums". Several frames are therefore true of one reading at once, and
# one of them CONTAINS its neighbours. Options that do not compete split a
# Choice's mass and it comes back flat.
#
# The spectrum is deliberately about what a person would DO, not about how much
# a frame says. A rubric rewarding coverage hands first place to the summary
# frame every time, forever, and the ticker becomes one line.
# The names are ours, for reporting. The wire carries the ORDERED LIST below and
# answers with a position on it, so these two must stay index-aligned.
RAIL_LEVELS = [
    "already_known",
    "background",
    "worth_noticing",
    "act_soon",
    "act_now",
]

RAIL_CRITERIA = [
    {
        "summary": "Reading it first changes nothing",
        "signals": [
            "Restates or adds up what other lines in this same reading already say",
            "A standing census the reader has seen every day",
            "Nothing in it is new since the last time they looked",
        ],
    },
    {
        "summary": "A true, stable fact about the shape of the workspace",
        "signals": ["Worth knowing", "Nothing to do about it", "Will read the same tomorrow"],
    },
    {
        "summary": "Something has drifted, and it will keep",
        "signals": [
            "The reader would want to know",
            "Nothing is harmed if they read it in a few minutes",
        ],
    },
    {
        "summary": "Names work that gets more expensive the longer it waits",
        "signals": [
            "Uncommitted changes, a branch fallen behind, a worktree holding work nobody is in",
            "Nothing is being lost yet",
        ],
    },
    {
        "summary": "Names something going wrong as the reader looks at it",
        "signals": [
            "Waiting costs work",
            "Two lines converging on the same files, a conflict, another writer inside "
            "a checkout the reader is about to change",
        ],
    },
]


def _send_tone():
    """Is the rail's own severity put in front of the model at all? Off by default.

    The rail assigns every frame a tone before this plugin sees it, and sends it.
    The obvious move is to pass it along — the model is better informed, and the
    caller keeps its ordering floor regardless. Measured on four deliberately
    ambiguous frames, holding the text fixed and flipping only the tone:

        tone in the state, question silent about it   0.40 mean, 0.70 worst
        tone in the state, question naming it         0.41 mean, 0.74 worst
        run-to-run noise on this instrument           0.10 stdev, 0.22 worst

    Naming it costs nothing — 0.40 against 0.41. **Sending it at all is what moves
    the answer**, four times the noise floor, before a single word of the question
    mentions it. So the choice was never how to word this; it was whether the
    rail's own severity belongs in front of the model, and a field in the state
    is read whether or not anything points at it.

    Re-measured after this switch went in, which gives the experiment its own
    control: with tone withheld, flipping it has no causal path at all, and the
    arm reads 0.16 — the noise floor, measured under the same conditions rather
    than quoted from elsewhere. With the switch on it reads 0.49 mean, 0.94 worst.

    It stays out, because the value here is a SECOND opinion. The caller already
    enforces severity with an ordering floor a warning cannot fall through, which
    is a constraint rather than a suggestion and does not need this question's
    agreement. Two readings that agree because one of them read the other are one
    reading. What is NOT measured is whether that 0.40 shift is correct — a warn
    line may well deserve to rank higher — so this is a switch and not a deletion:
    `TD_JEV_RAIL_TONE=1` sends it and names it, for re-deciding against real
    readings rather than the four fixtures behind the numbers above.
    """
    return os.environ.get("TD_JEV_RAIL_TONE", "").strip().lower() in ("1", "true", "yes")


def _tone_clause(idx):
    """The sentence naming tone, when it is being sent. Empty when it is not."""
    if not _send_tone():
        return ""
    return (" `frames[%d].tone` is the severity the status bar itself assigned this "
            "line. Treat it as one more fact about the line, not as the answer: the "
            "reader can already see the colour, and what is being asked is what they "
            "should DO about it." % idx)


def _rail_question(idx):
    f = "`frames[%d]" % idx
    return {
        "type": "score",
        "instructions": {
            "question":
                "A person has just come back to a window showing this project's status "
                "bar. %s.text` is one line that bar can show, of kind %s.kind`. How "
                "much would reading THAT line first change what they do next, given "
                "`facts` as the whole situation it came out of?" % (f, f),
            "focus":
                "Judge the line on what it would make the reader DO, never on how much "
                "of the picture it covers. Several of these lines are true at once and "
                "one of them may sum up the others; a line that summarises its "
                "neighbours tells the reader nothing they cannot get from the lines it "
                "summarises. In `facts`, a null is a measurement git could not take — "
                "not a zero, and not permission to assume the thing is absent."
                + _tone_clause(idx),
        },
        "criteria": RAIL_CRITERIA,
    }


# The one question about the whole reading rather than any line of it. Phrased so
# that a high value means yes, and about the COMBINATION — which is the only part
# no single frame's score already expresses.
ATTENTION_QUESTION = {
    "type": "noul",
    "instructions": {
        "question":
            "A person has come back to this window and means to start something new. "
            "Taking `facts` as a whole rather than any single line of `frames`, should "
            "they deal with what this project's state shows BEFORE starting anything "
            "new?",
        "focus":
            "Judge the combination, not the worst single line. A null in `facts` is a "
            "measurement git could not take, not a zero.",
    },
    "criteria": {
        "true": "Starting new work now would make the existing situation worse or lose "
                "some of it — for example uncommitted work sitting in a checkout "
                "another writer is in.",
        "false": "The situation will keep. Starting something else costs nothing that "
                 "cannot be picked up later.",
    },
}


def do_rail_weather(args):
    """Rank the project rail's ticker frames, and say whether the window wants you.

    Returns `ranked` as frame ids best first. A frame with no score is LEFT OUT of
    the ranking rather than sorted to the bottom: unranked means "not judged", the
    rail keeps git's own order for those, and that is a different statement from
    "judged and found least important". `attention` is null when the noul abstained
    and is never turned into a number here.
    """
    frames = args.get("frames")
    if not isinstance(frames, list) or not frames:
        return {"available": False, "reason": "rail_weather needs a non-empty `frames` array",
                "reading": args.get("reading"), "attention": None, "ranked": None}
    facts = args.get("facts") or {}

    c, st = _client()
    if c is None:
        return {"available": False, "reason": st["reason"], "reading": args.get("reading"),
                "attention": None, "ranked": None}

    state = {
        "project": args.get("project"),
        "facts": facts,
        # `tone` is accepted on every frame and deliberately NOT forwarded unless
        # asked for — see `_send_tone`. Dropping it here rather than at the
        # question is the point: a field in the state moves the answer whether or
        # not any question mentions it.
        "frames": [dict({"id": f.get("id"), "kind": f.get("kind"), "text": f.get("text")},
                        **({"tone": f.get("tone")} if _send_tone() else {}))
                   for f in frames],
    }
    questions = {"frame_%d" % i: _rail_question(i) for i in range(len(frames))}
    questions["attention"] = ATTENTION_QUESTION
    answers = c.ask_many(state, questions)

    scored = []       # (level_index, original_position, id)
    unjudged = []
    detail = []
    for i, f in enumerate(frames):
        d = answers.get("frame_%d" % i)
        value = None if d is None or getattr(d, "abstained", False) else getattr(d, "value", None)
        rank = _level_index(value)
        detail.append({
            "id": f.get("id"),
            "kind": f.get("kind"),
            "level": _level_name(rank),
            "position": rank,
            "reason": None if rank is not None else (
                getattr(d, "reason", None) if d is not None else "error:missing_answer"),
        })
        if rank is None:
            unjudged.append(f.get("id"))
        else:
            scored.append((rank, i, f.get("id")))

    # Coarsen to bands before ordering, because the raw score has a MEASURED
    # positional bias and sorting on it would dress that bias as a judgement.
    # Within a band the rail's own order stands: git already decided it, and a
    # difference smaller than the instrument's resolution is not a disagreement.
    band = _band_width()
    scored.sort(key=lambda t: (-int(t[0] / band) if band > 0 else -t[0], t[1]))

    a = answers.get("attention")
    attention = None
    if a is not None and not getattr(a, "abstained", False):
        v = getattr(a, "value", None)
        if isinstance(v, (int, float)) and 0.0 <= float(v) <= 1.0:
            attention = float(v)

    return {
        "available": True,
        "reason": None,
        "reading": args.get("reading"),
        "attention": attention,
        "ranked": [t[2] for t in scored],
        "band": band,
        "unjudged": unjudged,
        "frames": detail,
        "backend": st["model"],
    }


def _band_width():
    """How far two frames must separate before we claim one outranks the other.

    This is a RESOLUTION, not a confidence floor, and the difference matters.
    A confidence floor would be a guess about when to believe an answer, and this
    plugin ships none. This is a measured property of the instrument: asking one
    batch four times moved a frame by at most 0.22 levels (stdev 0.10), but
    reversing the frame array moved scores by 0.43 on average and 1.26 at worst,
    and two BYTE-IDENTICAL frames sat ~0.98 apart in every run with the earlier
    one always winning. So the model partly anchors on the order it is given —
    which is the order we were asked to improve on.

    1.5 is the worst measured positional effect rounded up. It was derived from
    two fixtures on one day, so it is an estimate with its method attached rather
    than a swept threshold; `TD_JEV_RAIL_BAND` overrides it, and 0 turns banding
    off and sorts on the raw score, bias and all.
    """
    try:
        return float(os.environ.get("TD_JEV_RAIL_BAND", "1.5"))
    except ValueError:
        return 1.5


def _level_index(value):
    """Where a Score landed, or None. A position we did not offer is not an answer.

    A Score is a probability-weighted position and lands BETWEEN levels routinely,
    so the float is kept rather than rounded — it is the ordering we want, and
    rounding two frames to the same level throws away a real difference.
    """
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)) and 0 <= float(value) <= len(RAIL_LEVELS) - 1:
        return float(value)
    if isinstance(value, str) and value in RAIL_LEVELS:
        return float(RAIL_LEVELS.index(value))
    return None


def _level_name(rank):
    """The nearest named level, for a human reading the payload. None stays None."""
    if rank is None:
        return None
    return RAIL_LEVELS[min(int(round(rank)), len(RAIL_LEVELS) - 1)]


