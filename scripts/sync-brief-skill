#!/usr/bin/env bash
# Copy the briefing kit from agent-skills into TD, or check that TD's copy is
# what it says it is.
#
# Terminal Delight carries the briefing skill inside its own binary
# (app/src/briefkit.rs) and writes it out for every agent it briefs, so the
# briefing can point at a SKILL.md that is on disk on any machine TD runs on.
# Briefing builds its HTML pages with two sibling skills, so the kit is three
# directories laid side by side, the way brief.py looks for them:
#
#   briefing/           the whole skill an agent follows
#   decision-brief/     only the look and the notes engine briefing builds with;
#                       not its SKILL.md, which TD no longer asks agents to follow
#   fancy-pants-brief/  only the section rail and the glass gate; not its SKILL.md
#
# Every file is vendored byte for byte from one commit of
# parker-brown-family/agent-skills, and app/skills/SOURCE names that commit.
#
#   scripts/sync-brief-skill [--from <agent-skills checkout>] [--ref <commit>]
#   scripts/sync-brief-skill --check [--from <checkout>] [--ref <commit>]
#
# The source is always a COMMIT, read with `git archive`, never a working tree:
# uncommitted edits in the skill are not the skill. --from defaults to the local
# checkout if there is one, otherwise a fresh clone of the public repository.
# --ref defaults to origin/main when syncing, and to the commit SOURCE names
# when checking. The notes-format fixtures are not part of the kit; they are
# scripts/sync-brief-fixtures' job.
#
# Exit 0: in step (or synced). 1: the copy differs from the ref. 2: bad input.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEST="$ROOT/app/skills"
# What the kit carries, per skill directory. Nothing else is copied.
PARTS="briefing/SKILL.md briefing/LICENSE briefing/README.md briefing/assets briefing/reference briefing/scripts
briefing/examples briefing/tests/browser.mjs
decision-brief/LICENSE decision-brief/assets decision-brief/reference decision-brief/scripts/brief-wall
fancy-pants-brief/LICENSE fancy-pants-brief/assets fancy-pants-brief/scripts/fancy-pants"
SKILLS="briefing decision-brief fancy-pants-brief"
REPO="parker-brown-family/agent-skills"
FROM=""
REF=""
CHECK=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --from) FROM=$2; shift 2 ;;
    --ref) REF=$2; shift 2 ;;
    *) echo "unknown argument $1"; exit 2 ;;
  esac
done

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

if [ -z "$FROM" ]; then
  local_checkout="$HOME/BROWN-FAMILY-SPORTS/Software/agent-skills"
  if git -C "$local_checkout" rev-parse --git-dir >/dev/null 2>&1; then
    FROM=$local_checkout
  else
    git clone -q "https://github.com/$REPO.git" "$TMP/agent-skills" || { echo "could not clone $REPO"; exit 2; }
    FROM="$TMP/agent-skills"
  fi
fi
git -C "$FROM" fetch -q origin 2>/dev/null || true

if [ -z "$REF" ]; then
  if [ "$CHECK" -eq 1 ]; then
    REF=$(awk 'NR==1 {print $2}' "$DEST/SOURCE" 2>/dev/null)
    [ -n "$REF" ] || { echo "no commit named in $DEST/SOURCE"; exit 2; }
  else
    REF=origin/main
  fi
fi
COMMIT=$(git -C "$FROM" rev-parse --verify --quiet "$REF^{commit}") || { echo "$REF is not a commit in $FROM"; exit 2; }
SHORT=$(git -C "$FROM" rev-parse --short "$COMMIT")

mkdir -p "$TMP/theirs"
# shellcheck disable=SC2086 # PARTS is a word list on purpose
git -C "$FROM" archive "$COMMIT" $PARTS | tar -x -C "$TMP/theirs" ||
  { echo "the kit's parts are not all in $REPO at $SHORT"; exit 2; }

if [ "$CHECK" -eq 1 ]; then
  status=0
  : >"$TMP/diff"
  for skill in $SKILLS; do
    diff -r -q "$DEST/$skill" "$TMP/theirs/$skill" >>"$TMP/diff" 2>&1 || status=1
  done
  if [ "$status" -eq 0 ]; then
    echo "in step: TD's kit is byte-identical to $REPO@$SHORT"
    exit 0
  fi
  echo "differs from $REPO@$SHORT ($(wc -l <"$TMP/diff") paths):"
  sed "s|$DEST|td|g; s|$TMP/theirs|skill|g" "$TMP/diff" | head -40
  exit 1
fi

for skill in $SKILLS; do
  rm -rf "${DEST:?}/$skill"
  cp -a "$TMP/theirs/$skill" "$DEST/$skill"
done
{
  echo "$REPO $SHORT"
  echo "$PARTS" | tr '\n' ' ' | sed 's/ $//'
  echo ""
  echo ""
  echo "Copied byte for byte from that commit (git archive), every file under"
  echo "briefing/, decision-brief/ and fancy-pants-brief/. The binary embeds every"
  echo "one (app/src/briefkit.rs) and a test fails if one is missing from its list."
  echo "Do not edit the copied files by hand: change the skill, then run"
  echo "scripts/sync-brief-skill and name the new commit above."
} >"$DEST/SOURCE"
echo "synced from $REPO@$SHORT; run cargo test briefkit before committing"
