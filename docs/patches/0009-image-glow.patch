+// td-image-glow: a bounded, separable 4x4 bright-pass kernel. The scene
+// texture already exists for CRT; no history or additional blur target is held.
+// Sampling in source space makes the halo bend with the letters. Out-of-pane
+// samples are black rather than clamped, so a neighbour cannot light this pane.
+fn glow_emission(p: vec2<f32>, r: vec4<f32>) -> vec3<f32> {
+    if (any(p < r.xy + vec2<f32>(0.5)) || any(p >= r.xy + r.zw - vec2<f32>(0.5))) {
+        return vec3<f32>(0.0);
+    }
+    let dims = vec2<f32>(textureDimensions(screen_tex));
+    let sample = textureSampleLevel(screen_tex, screen_samp, p / dims, 0.0);
+    let peak = max(sample.r, max(sample.g, sample.b));
+    let bright = max(peak - 0.12, 0.0) / max(peak, 0.0001);
+    return sample.rgb * bright * sample.a;
+}
+
+fn image_bloom(base: vec3<f32>, p: vec2<f32>, r: vec4<f32>, strength: f32) -> vec3<f32> {
+    if (strength <= 0.0) { return base; }
+    let offsets = array<f32, 4>(-3.0, -1.0, 1.0, 3.0);
+    let weights = array<f32, 4>(1.0, 3.0, 3.0, 1.0);
+    var halo = vec3<f32>(0.0);
+    for (var y = 0u; y < 4u; y += 1u) {
+        for (var x = 0u; x < 4u; x += 1u) {
+            let offset = vec2<f32>(offsets[x], offsets[y]) * 1.6;
+            halo += glow_emission(p + offset, r) * (weights[x] * weights[y] / 64.0);
+        }
+    }
+    // Screen blend preserves the sharp core and each colour channel's hue.
+    return base + halo * strength * 1.8 * (vec3<f32>(1.0) - base);
 }

