+// td-doc-shoulder: where a document's highlights on a CURVED tube start to
+// roll off, and the light grey they approach instead of white. The curved path
+// draws its screen 35% hotter after the document grade (`tube = lit_col * ...
+// * 1.35`), so everything a person's gauges left above about 0.74 went past
+// white and clipped: the glow pane ignored the top of the brightness and
+// contrast sliders. Below the knee nothing changes.
+const DOC_SHOULDER_KNEE: f32 = 0.78;
+const DOC_SHOULDER_CEILING: f32 = 0.9;
+
+// td-doc-shoulder: whether source pixel `p` is a document's, by the same rule
+// as `doc_graded`: the last rect holding it decides, so a panel kept out of a
+// document's grade is not a document either.
+fn in_document(p: vec2<f32>) -> bool {
+    for (var i = u32(crt.k.w); i > 0u; i = i - 1u) {
+        let r = crt.doc_rects[i - 1u];
+        if (p.x >= r.x && p.x < r.x + r.z && p.y >= r.y && p.y < r.y + r.w) {
+            return crt.doc_grade[i - 1u].z > 0.5;
+        }
+    }
+    return false;
+}
+
+// td-doc-shoulder: a document's colour on the curved tube. A pixel whose
+// luminance is at or under the knee is returned as it came, bit for bit; a
+// brighter one is scaled down as a whole so its luminance rolls off toward the
+// ceiling, continuous and with slope 1 at the knee. Scaling the whole colour
+// keeps its hue: a cyan header stays cyan instead of going pale, and a
+// saturated mid-tone (a purple card whose blue alone is bright) is untouched.
+// Anything that is not a document passes through.
+fn doc_shoulder(col: vec3<f32>, p: vec2<f32>) -> vec3<f32> {
+    if (!in_document(p)) {
+        return col;
+    }
+    let l = dot(col, vec3<f32>(0.2126, 0.7152, 0.0722));
+    if (l <= DOC_SHOULDER_KNEE) {
+        return col;
+    }
+    let span = DOC_SHOULDER_CEILING - DOC_SHOULDER_KNEE;
+    let rolled = DOC_SHOULDER_KNEE + span * (1.0 - exp(-(l - DOC_SHOULDER_KNEE) / span));
+    return col * (rolled / l);
+}
+
