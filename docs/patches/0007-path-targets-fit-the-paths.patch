+    // td-path-targets-fit: where this batch sits in the path target, and the
+    // target's size, so the sprite samples its own patch of a texture sized to
+    // the paths rather than the whole surface (terminal-delight#962).
+    atlas_origin: [f32; 2],
+    atlas_size: [f32; 2],
+}
+
+/// td-path-targets-fit: the device-pixel rectangle a batch of paths covers, as
+/// a whole-pixel origin and a size. Rasterising at a whole-pixel offset keeps
+/// every sample where it was, so the composited pixels are unchanged.
+fn path_batch_rect(paths: &[Path<ScaledPixels>]) -> ([f32; 2], [f32; 2]) {
+    let mut bounds = paths[0].clipped_bounds();
+    for path in paths.iter().skip(1) {
+        bounds = bounds.union(&path.clipped_bounds());
+    }
+    let x0 = bounds.origin.x.0.max(0.0).floor();
+    let y0 = bounds.origin.y.0.max(0.0).floor();
+    let x1 = (bounds.origin.x.0 + bounds.size.width.0).ceil();
+    let y1 = (bounds.origin.y.0 + bounds.size.height.0).ceil();
+    ([x0, y0], [(x1 - x0).max(1.0), (y1 - y0).max(1.0)])
 }
 
