+    /// Paint the glyphs emitted by `f` through `transformation`.
+    ///
+    /// The matrix operates in SCALED (physical) pixels, the space sprite quads
+    /// live in, so rotating about a point is
+    /// `unit().translate(pivot * scale_factor).rotate(angle).translate(-pivot * scale_factor)`.
+    ///
+    /// Only the painted quad moves — layout, content masks and hit-testing stay
+    /// in the flat box, so an element that must stay clickable under a non-unit
+    /// transform has to resolve its own hit-testing.
+    pub fn with_text_transformation<R>(
+        &mut self,
+        transformation: TransformationMatrix,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+
+        let previous = self.text_transform;
+        self.text_transform = previous.compose(transformation);
+        let result = f(self);
+        self.text_transform = previous;
+        result
+    }
+
