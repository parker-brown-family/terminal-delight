+// ---- terminal-delight floating document grade ----
+// A document's rect (physical px) and its brightness and contrast gains around
+// 1.0. Beside the tubes rather than in them: the app flattens the glass while an
+// overlay is up, and a document's grade has to stay on the screen through that.
+static DOC_GRADES: std::sync::Mutex<Vec<([f32; 4], f32, f32)>> =
+    std::sync::Mutex::new(Vec::new());
+
+/// Grade these rects this frame, the last on top where they overlap. Empty
+/// leaves the pass to the tubes; any entry keeps it live on a flat screen.
+pub fn set_doc_grades(grades: &[([f32; 4], f32, f32)]) {
+    let mut guard = DOC_GRADES.lock().unwrap();
+    guard.clear();
+    guard.extend(grades.iter().take(32).copied());
+}
+
+/// Returns (rects, gains [brightness, contrast, _, _], count).
+fn doc_grades() -> ([[f32; 4]; 32], [[f32; 4]; 32], u32) {
+    let guard = DOC_GRADES.lock().unwrap();
+    let mut rects = [[0.0f32; 4]; 32];
+    let mut gains = [[0.0f32; 4]; 32];
+    for (i, (r, b, c)) in guard.iter().take(32).enumerate() {
+        rects[i] = *r;
+        gains[i] = [*b, *c, 0.0, 0.0];
+    }
+    (rects, gains, guard.len().min(32) as u32)
+}
