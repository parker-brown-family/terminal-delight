+// td-tube-blur: soften one tube's own picture. The same golden-angle disk as
+// the FOCUS backdrop, but every tap is held inside the tube, so a neighbour's
+// edge never bleeds in and the blur stops where the pane does.
+fn tube_blur(p: vec2<f32>, r: vec4<f32>, radius: f32) -> vec3<f32> {
+    let dims = vec2<f32>(textureDimensions(screen_tex));
+    let lo = r.xy + vec2<f32>(0.5);
+    let hi = r.xy + r.zw - vec2<f32>(0.5);
+    let ign = fract(52.9829189 * fract(dot(p, vec2<f32>(0.06711056, 0.00583715))));
+    let rot = ign * 6.2831853;
+    var acc = vec3<f32>(0.0);
+    var wsum = 0.0;
+    for (var t = 0; t < 32; t = t + 1) {
+        let ft = f32(t) + 0.5;
+        let rr = sqrt(ft / 32.0);
+        let ang = ft * 2.3999632 + rot;
+        let q = clamp(p + vec2<f32>(cos(ang), sin(ang)) * rr * radius, lo, hi);
+        let w = exp(-rr * rr * 1.8);
+        acc = acc + textureSampleLevel(screen_tex, screen_samp, q / dims, 0.0).rgb * w;
+        wsum = wsum + w;
+    }
+    return acc / max(wsum, 1e-4);
+}
